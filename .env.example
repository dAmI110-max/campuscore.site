# Copy values into the appropriate local secret manager or deployment settings.
# Never commit a filled-in .env file. VITE_ values are public and embedded at build time.

# Server runtime
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
CLERK_SECRET_KEY=replace_in_secret_manager
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_public_key
PLATFORM_OWNER_EMAIL=owner@example.invalid
GCS_CREDENTIALS_JSON=
PRIVATE_OBJECT_DIR=/campus-core-private/uploads
PUBLIC_OBJECT_SEARCH_PATHS=/campus-core-public/assets
LOG_LEVEL=info
# Vercel scheduled upload cleanup only. Set a random value of at least 32
# characters in Vercel Secrets; leave unset here so cleanup fails closed.
# CRON_SECRET=

# Payment defaults are deliberately disabled. Use Paystack test credentials only in staging.
PAYMENTS_ENABLED=false
PAYSTACK_MODE=test
PAYSTACK_SECRET_KEY=sk_test_replace_in_secret_manager
PAYSTACK_CALLBACK_URL=https://campus-core.example.invalid/payment/callback
PAYSTACK_WEBHOOKS_ENABLED=false
PAYSTACK_LIVE_CHECKOUT_ENABLED=false

# Browser build variables (public; never put secrets in VITE_ variables)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_public_key
# Optional only when the Clerk proxy is hosted on a different origin.
VITE_CLERK_PROXY_URL=

# Optional staging test runner only; never target production.
# API_TEST_BASE_URL=https://staging.example.invalid/api
# CAMPUS_CORE_STAGING_CONFIRMATION=I_CONFIRM_NON_PRODUCTION_STAGING
