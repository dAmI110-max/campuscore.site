{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node test.mjs",
    "test:staging": "node test-staging.mjs",
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "build:vercel": "node ./build.mjs --vercel",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clerk/express": "^2.1.82",
    "@clerk/shared": "^4.41.0",
    "@google-cloud/storage": "^8.4.0",
    "@vercel/functions": "^3.10.3",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "http-proxy-middleware": "^4.2.0",
    "pg": "8.23.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "sharp": "^0.35.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.2.0",
    "thread-stream": "3.1.0"
  }
}
